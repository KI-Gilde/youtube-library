# PostgreSQL
POSTGRES_USER=ytlib
POSTGRES_PASSWORD=change_me
POSTGRES_DB=youtube_library

# Whisper model for transcription
# Options: tiny, base, small, medium, large
WHISPER_MODEL=medium

# LLM API (any OpenAI-compatible endpoint)
# The endpoint must provide chat completions AND embeddings.
# Defaults target the optional local llama.cpp server
# (start it with: docker compose --profile llm up -d).
#LLM_API_BASE=https://api.example.com/v1
#LLM_API_KEY=sk-your-key-here
#LLM_CHAT_MODEL=your-chat-model
#LLM_UTILITY_MODEL=your-fast-model
#EMBEDDING_MODEL=bge-m3

# GGUF model file for the optional local llama.cpp server
# (path relative to ./models/, only used with --profile llm)
#LLM_MODEL_PATH=gpt-oss-20b.gguf
